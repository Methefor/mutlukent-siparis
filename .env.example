# Firebase Yapılandırması (isteğe bağlı - olmadan da çalışır, localStorage kullanır)
# Firebase Console'dan alın: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin PIN (varsayılan: 1234)
VITE_ADMIN_PIN=1234
