rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['branchId', 'branchName', 'supplierId', 'supplierName', 'items', 'status', 'date', 'createdAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sentAt']);
      allow delete: if false;
    }
  }
}
